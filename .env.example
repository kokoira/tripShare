# AWS 認証情報（S3 画像アップロード用）
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=tripshare-images-dev

# データベース接続情報（ローカル開発: Docker Compose のデフォルト値が使われるため省略可）
# DB_USERNAME=root
# DB_PASSWORD=password
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=tripshare_development
# DB_NAME_TEST=tripshare_test
# 本番環境では DATABASE_URL を SSM Parameter Store で管理し ECS タスクに渡す
# DATABASE_URL=mysql2://user:password@rds-endpoint:3306/tripshare_production

# Rails 設定
RAILS_ENV=development
RAILS_MASTER_KEY=your_rails_master_key
SECRET_KEY_BASE=your_secret_key_base

# フロントエンド設定
NEXT_PUBLIC_API_URL=http://localhost:3001
